# 운영 환경변수 (배포 플랫폼의 환경변수 설정에 입력)
#
# 이 파일에 실제 값을 넣지 마세요. 값은 플랫폼 대시보드에만 존재해야 합니다.

APP_ENV=production
LOG_LEVEL=INFO

# ── 인증 ────────────────────────────────────
# production에서 dev는 기동이 거부됩니다.
AUTH_MODE=supabase
SUPABASE_URL=https://xxxx.supabase.co

# ── 저장소 ──────────────────────────────────
# production에서 memory는 기동이 거부됩니다.
STORAGE=postgres
# Supabase → Connect → Session pooler 의 URI
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── CORS ────────────────────────────────────
# 프론트엔드 도메인. 콤마로 여러 개. localhost가 있으면 기동이 거부됩니다.
CORS_ORIGINS=https://your-app.vercel.app

# ── 외부 API ────────────────────────────────
OPENAI_API_KEY=
LAW_API_OC=
LLM_MODEL=gpt-4o

# ── RAG ─────────────────────────────────────
# Chroma는 로컬 디렉터리에 저장되므로 컨테이너 재시작 시 인덱스가 사라집니다.
# 영구 볼륨을 붙이고 배포 후 `python scripts/ingest_rag.py`를 한 번 돌리거나,
# 그럴 수 없으면 false로 두세요. (health의 rag_indexed_chunks로 확인 가능)
RAG_ENABLED=false
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=/data/.chroma
