# ── 애플리케이션 ─────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO

# ── LLM (OpenAI) ────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# ── 법제처 OPEN API ──────────────────────────
# open.law.go.kr 가입 이메일의 @ 앞부분 (예: hong@gmail.com -> hong)
LAW_API_OC=your_id

# ── RAG / Vector DB (W5) ────────────────────
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=.chroma
# PINECONE_API_KEY=
# PINECONE_INDEX=reg-radar

# ── Supabase (W3) ───────────────────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
