# ── 애플리케이션 ─────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO

# ── LLM (OpenAI) ────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# ── 법제처 OPEN API ──────────────────────────
# open.law.go.kr 가입 이메일의 @ 앞부분 (예: hong@gmail.com -> hong)
LAW_API_OC=your_id

# ── RAG / Vector DB ─────────────────────────
# false면 참고자료 없이 분석한다. 인덱스를 만들지 않은 환경의 기본값이며,
# BR-005에 따라 '참고자료 없음'은 정상 상태다.
RAG_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=.chroma
# 인덱스 구축: .venv/bin/python scripts/ingest_rag.py
# PINECONE_API_KEY=
# PINECONE_INDEX=reg-radar

# ── 저장소 ──────────────────────────────────
# memory: 인메모리 (재시작 시 소실). postgres: Supabase 또는 로컬 Postgres
STORAGE=memory
# DATABASE_URL=postgresql://127.0.0.1:5432/regradar
# Supabase: Project Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── 인증 ────────────────────────────────────
# dev: X-User-Id 헤더 신뢰 (로컬 전용). supabase: JWT 검증
AUTH_MODE=dev
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# Project Settings → API → JWT Settings → JWT Secret
# SUPABASE_JWT_SECRET=
